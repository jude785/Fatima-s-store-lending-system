<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Loan Details</h1>
    <p class="text-muted mb-0">Borrower info, balance, and payment history.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/payments/create" class="btn btn-primary"><i class="bi bi-wallet2"></i>Record Payment</a>
    <a href="/loans/<%= loan.loan_id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i>Edit Loan</a>
    <form action="/loans/<%= loan.loan_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this loan and all related payments and receipts?');">
      <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i>Delete Loan</button>
    </form>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-body detail-list">
    <h2 class="h5 mb-3">Borrower Information</h2>
    <p class="mb-2"><strong>Name:</strong> <%= loan.borrower_name %></p>
    <p class="mb-2"><strong>Contact:</strong> <%= loan.contact_number %></p>
    <p class="mb-0"><strong>Address:</strong> <%= loan.address %></p>
  </div></div></div>
  <div class="col-lg-8"><div class="card border-0 shadow-sm h-100"><div class="card-body">
    <h2 class="h5 mb-3">Loan Summary</h2>
    <div class="row g-3">
      <div class="col-md-4"><div class="summary-box"><span>Principal</span><strong>&#8369; <%= Number(loan.principal_amount).toFixed(2) %></strong></div></div>
      <div class="col-md-4"><div class="summary-box"><span>Interest</span><strong>&#8369; <%= Number(loan.interest_amount).toFixed(2) %></strong></div></div>
      <div class="col-md-4"><div class="summary-box"><span>Total Amount</span><strong>&#8369; <%= Number(loan.total_amount).toFixed(2) %></strong></div></div>
      <div class="col-md-4"><div class="summary-box"><span>Remaining Balance</span><strong>&#8369; <%= Number(loan.remaining_balance).toFixed(2) %></strong></div></div>
      <div class="col-md-4"><div class="summary-box"><span>Loan Date</span><strong><%= moment(loan.loan_date).format('YYYY-MM-DD') %></strong></div></div>
      <div class="col-md-4"><div class="summary-box"><span>Status</span><strong><%= loan.loan_status %></strong></div></div>
    </div>
  </div></div></div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <h2 class="h5 mb-3">Payment History</h2>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th>Payment ID</th><th>Date</th><th>Amount</th><th>Updated Balance</th><th>Receipt</th><th></th></tr></thead>
        <tbody>
          <% if (payments.length) { payments.forEach(payment => { %>
            <tr>
              <td>#<%= payment.payment_id %></td>
              <td><%= moment(payment.payment_date).format('YYYY-MM-DD') %></td>
              <td>&#8369; <%= Number(payment.payment_amount).toFixed(2) %></td>
              <td>&#8369; <%= Number(payment.updated_balance).toFixed(2) %></td>
              <td><a href="/payments/<%= payment.payment_id %>/receipt"><i class="bi bi-receipt me-1"></i>View Receipt</a></td>
              <td class="text-end">
                <form action="/payments/<%= payment.payment_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this payment and its receipt? The loan balance will be recalculated.');">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
                </form>
              </td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="6" class="text-center text-muted py-3">No payments recorded for this loan.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
