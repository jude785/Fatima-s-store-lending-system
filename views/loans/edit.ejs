<div class="mb-4">
  <h1 class="h3 fw-bold mb-1">Edit Loan</h1>
  <p class="text-muted mb-0">Update loan details and status.</p>
</div>
<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <form action="/loans/<%= loan.loan_id %>?_method=PUT" method="POST" class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Borrower</label>
        <select name="borrower_id" class="form-select" required>
          <% borrowers.forEach(b => { %>
            <option value="<%= b.borrower_id %>" <%= Number(loan.borrower_id) === Number(b.borrower_id) ? 'selected' : '' %>><%= b.last_name %>, <%= b.first_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3"><label class="form-label">Loan Date</label><input type="date" name="loan_date" class="form-control" value="<%= moment(loan.loan_date).format('YYYY-MM-DD') %>" required></div>
      <div class="col-md-3"><label class="form-label">Due Date</label><input type="date" name="due_date" class="form-control" value="<%= moment(loan.due_date).format('YYYY-MM-DD') %>" required></div>
      <div class="col-md-3"><label class="form-label">Principal Amount</label><input type="number" min="0" step="0.01" name="principal_amount" class="form-control" value="<%= loan.principal_amount %>" required></div>
      <div class="col-md-3"><label class="form-label">Interest Amount</label><input type="number" min="0" step="0.01" name="interest_amount" class="form-control" value="<%= loan.interest_amount %>" required></div>
      <div class="col-md-3"><label class="form-label">Status</label>
        <select name="loan_status" class="form-select">
          <option value="Ongoing" <%= loan.loan_status === 'Ongoing' ? 'selected' : '' %>>Ongoing</option>
          <option value="Overdue" <%= loan.loan_status === 'Overdue' ? 'selected' : '' %>>Overdue</option>
          <option value="Paid" <%= loan.loan_status === 'Paid' ? 'selected' : '' %>>Paid</option>
        </select>
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-check2-circle"></i>Update Loan</button>
        <a href="/loans" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
