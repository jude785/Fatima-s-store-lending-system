<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Payments</h1>
    <p class="text-muted mb-0">Record collections and print receipts.</p>
  </div>
  <a href="/payments/create" class="btn btn-primary"><i class="bi bi-wallet2 me-1"></i>Record Payment</a>
</div>
<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>ID</th><th>Borrower</th><th>Date</th><th>Amount</th><th>Balance</th><th>Type</th><th>Method</th><th></th></tr></thead>
      <tbody>
        <% if (payments.length) { payments.forEach(payment => { %>
          <tr>
            <td>#<%= payment.payment_id %></td>
            <td><%= payment.borrower_name %></td>
            <td><%= moment(payment.payment_date).format('YYYY-MM-DD') %></td>
            <td>&#8369; <%= Number(payment.payment_amount).toFixed(2) %></td>
            <td>&#8369; <%= Number(payment.updated_balance).toFixed(2) %></td>
            <td><span class="badge text-bg-primary"><%= payment.payment_type %></span></td>
            <td>
              <span class="badge text-bg-secondary"><%= payment.payment_method || 'Cash' %></span>
              <% if (payment.reference_number) { %>
                <div class="small text-muted mt-1">Ref: <%= payment.reference_number %></div>
              <% } %>
            </td>
            <td>
              <div class="d-flex justify-content-end gap-2">
                <a href="/payments/<%= payment.payment_id %>/receipt" class="btn btn-sm btn-outline-primary"><i class="bi bi-receipt"></i>Receipt</a>
                <form action="/payments/<%= payment.payment_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this payment and its receipt? The loan balance will be recalculated.');">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) } else { %>
          <tr><td colspan="8" class="text-center text-muted py-4">No payment records found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
