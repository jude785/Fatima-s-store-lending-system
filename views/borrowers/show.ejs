<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Borrower Details</h1>
    <p class="text-muted mb-0">Profile, loan history, and recent payments.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/borrowers/<%= borrower.borrower_id %>/edit" class="btn btn-outline-primary"><i class="bi bi-pencil"></i>Edit Record</a>
    <form action="/borrowers/<%= borrower.borrower_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this borrower and all related loans, payments, and receipts?');">
      <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i>Delete Borrower</button>
    </form>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100"><div class="card-body detail-list">
      <h2 class="h5 mb-3">Borrower Profile</h2>
      <p class="mb-2"><strong>Name:</strong> <%= borrower.first_name %> <%= borrower.middle_name || '' %> <%= borrower.last_name %></p>
      <p class="mb-2"><strong>Address:</strong> <%= borrower.address %></p>
      <p class="mb-2"><strong>Contact:</strong> <%= borrower.contact_number %></p>
      <p class="mb-2"><strong>Status:</strong> <%= borrower.borrower_status %></p>
      <p class="mb-0"><strong>Date Registered:</strong> <%= moment(borrower.date_registered).format('YYYY-MM-DD') %></p>
    </div></div>
  </div>
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <h2 class="h5 mb-3">Loan History</h2>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead class="table-light"><tr><th>Loan ID</th><th>Date</th><th>Total</th><th>Balance</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% if (loans.length) { loans.forEach(loan => { %>
            <tr>
              <td><a href="/loans/<%= loan.loan_id %>">#<%= loan.loan_id %></a></td>
              <td><%= moment(loan.loan_date).format('YYYY-MM-DD') %></td>
              <td>&#8369; <%= Number(loan.total_amount).toFixed(2) %></td>
              <td>&#8369; <%= Number(loan.remaining_balance).toFixed(2) %></td>
              <td><span class="badge text-bg-<%= loan.loan_status === 'Paid' ? 'success' : 'warning' %>"><%= loan.loan_status %></span></td>
              <td class="text-end">
                <form action="/loans/<%= loan.loan_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this loan and all related payments and receipts?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
                </form>
              </td>
            </tr>
            <% }) } else { %>
            <tr><td colspan="6" class="text-center text-muted py-3">No loans recorded.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div></div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <h2 class="h5 mb-3">Recent Payments</h2>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead class="table-light"><tr><th>Payment ID</th><th>Date</th><th>Amount</th><th>Updated Balance</th><th></th></tr></thead>
        <tbody>
          <% if (payments.length) { payments.forEach(payment => { %>
          <tr>
            <td><a href="/payments/<%= payment.payment_id %>/receipt">#<%= payment.payment_id %></a></td>
            <td><%= moment(payment.payment_date).format('YYYY-MM-DD') %></td>
            <td>&#8369; <%= Number(payment.payment_amount).toFixed(2) %></td>
            <td>&#8369; <%= Number(payment.updated_balance).toFixed(2) %></td>
            <td class="text-end">
              <form action="/payments/<%= payment.payment_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this payment and its receipt? The loan balance will be recalculated.');">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
              </form>
            </td>
          </tr>
          <% }) } else { %>
          <tr><td colspan="5" class="text-center text-muted py-3">No payments recorded.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
