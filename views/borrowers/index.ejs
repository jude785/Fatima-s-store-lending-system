<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Borrowers</h1>
    <p class="text-muted mb-0">Manage borrower records and view loan history.</p>
  </div>
  <a href="/borrowers/create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add Borrower</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form class="row g-2 mb-3" method="GET">
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" name="keyword" class="form-control" placeholder="Search by name or contact number" value="<%= keyword %>">
        </div>
      </div>
      <div class="col-auto">
        <button class="btn btn-outline-primary"><i class="bi bi-search me-1"></i>Search</button>
      </div>
    </form>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>ID</th><th>Name</th><th>Contact</th><th>Status</th><th>Date Registered</th><th></th></tr></thead>
        <tbody>
          <% if (borrowers.length) { borrowers.forEach(borrower => { %>
          <tr>
            <td>#<%= borrower.borrower_id %></td>
            <td><%= borrower.first_name %> <%= borrower.middle_name || '' %> <%= borrower.last_name %></td>
            <td><%= borrower.contact_number %></td>
            <td><span class="badge text-bg-<%= borrower.borrower_status === 'Active' ? 'success' : 'secondary' %>"><%= borrower.borrower_status %></span></td>
            <td><%= moment(borrower.date_registered).format('YYYY-MM-DD') %></td>
            <td>
              <div class="d-flex justify-content-end gap-2">
              <a href="/borrowers/<%= borrower.borrower_id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i>View</a>
              <a href="/borrowers/<%= borrower.borrower_id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i>Edit</a>
              <form action="/borrowers/<%= borrower.borrower_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this borrower and all related loans, payments, and receipts?');">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</button>
              </form>
              </div>
            </td>
          </tr>
          <% }) } else { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No borrower records found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
