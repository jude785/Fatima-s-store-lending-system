<div class="mb-4">
  <h1 class="h3 fw-bold mb-1">Edit User</h1>
  <p class="text-muted mb-0">Update account access, role, or password.</p>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <form action="/users/<%= user.user_id %>?_method=PUT" method="POST" class="row g-3">
      <%- csrfField %>
      <div class="col-md-6"><label class="form-label">Username</label><input class="form-control" value="<%= user.username %>" disabled></div>
      <div class="col-md-6"><label class="form-label">Full Name</label><input name="full_name" class="form-control" value="<%= user.full_name %>" required></div>
      <div class="col-md-4">
        <label class="form-label">Role</label>
        <select name="role" class="form-select" required>
          <% roles.forEach(role => { %>
            <option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= role %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="1" <%= user.status ? 'selected' : '' %>>Active</option>
          <option value="0" <%= !user.status ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <div class="col-md-4"><label class="form-label">New Password</label><input type="password" name="password" class="form-control" autocomplete="new-password" placeholder="Leave blank to keep current"></div>
      <div class="col-12">
        <p class="text-muted small mb-0">New passwords must use at least 10 characters with uppercase, lowercase, number, and symbol.</p>
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-check2-circle"></i>Update User</button>
        <a href="/users" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
