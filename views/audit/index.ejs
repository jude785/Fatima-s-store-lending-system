<div class="mb-4">
  <h1 class="h3 fw-bold mb-1">Audit Logs</h1>
  <p class="text-muted mb-0">Recent security and transaction activity.</p>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>IP Address</th><th>Details</th></tr></thead>
      <tbody>
        <% if (logs.length) { logs.forEach(log => { %>
          <tr>
            <td><%= moment(log.created_at).format('YYYY-MM-DD HH:mm') %></td>
            <td><%= log.username || 'System' %></td>
            <td><span class="badge text-bg-primary"><%= log.action %></span></td>
            <td><%= log.entity_type %><%= log.entity_id ? ` #${log.entity_id}` : '' %></td>
            <td><%= log.ip_address || '-' %></td>
            <td class="small text-muted"><%= log.details || '-' %></td>
          </tr>
        <% }) } else { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No audit records found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
